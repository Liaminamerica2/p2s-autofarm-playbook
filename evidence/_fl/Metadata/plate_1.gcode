; --- V2.93 MQTT sentinel: T2 (cool-done) ---
M104 S3                ; FL_S2 T2 sentinel (start bending via nozzle_target_temper=3)

; --- TRIGGER 2: Triple tap - Start bending ---
G4 P500
G1 Z255 F1000    ; Tap 1
G4 P150
G1 Z243 F3000
G4 P300
G1 Z255 F1000    ; Tap 2
G4 P150
G1 Z243 F3000
G4 P300
G1 Z255 F1000    ; Tap 3
G4 P150
G1 Z243 F3000

G4 P6000         ; Wait for count window to expire

; --- Wait for bending cycles ---
; 5 cycles × ~16s each = ~80 seconds
; Adjust based on your configured cycle count
G4 P85000        ; Wait for bending complete

; @fl:section:start "p2s.clear.sweep"
;============================= PUSH SECTION =============================
; ---------- choose sweep height ----------

; @fl:replace next 1 "clear-height.smart-default"
G1 Z160.00 F10000

M400

; -------- central sweeps (2×) --------
G1 X125 F3000          ; move to mid-X and start first sweep
G1 Y250 F3000          ; rear edge
G1 Y0   F3000          ; front edge
G1 Y250 F3000          ; rear edge – second sweep
G1 Y0   F3000          ; front edge

; -------- extended right-to-left rake --------
; Start at far right (X220), sweep back→front, then step leftward 30 mm each pass
G1 Y250 F3000
G1 X220 F3000
G1 Y0   F3000

G1 Y250 F3000
G1 X190 F3000
G1 Y0   F3000

G1 Y250 F3000
G1 X160 F3000
G1 Y0   F3000

G1 Y250 F3000
G1 X130 F3000
G1 Y0   F3000

G1 Y250 F3000
G1 X100 F3000
G1 Y0   F3000

G1 Y250 F3000
G1 X70  F3000
G1 Y0   F3000

G1 Y250 F3000
G1 X30  F3000          ; **last pass now at X30 instead of X40**
G1 Y0   F3000          ; finish at front edge on X30

; ---------- choose sweep height ----------

G1 Y250 F3000

M400
G1 X220 F3000

M400

G1 Z160.00 F12000 ; lift to Z = 160.00 mm

M400 ; wait for Z move to finish

; -------- extended right-to-left rake --------
; Start at far right (X220), sweep back→front, then step leftward 30 mm each pass
G1 Y250 F12000
G1 X220 F12000
G1 Y0   F12000

G1 Y250 F12000
G1 X190 F12000
G1 Y0   F12000

G1 Y250 F12000
G1 X160 F12000
G1 Y0   F12000

G1 Y250 F12000
G1 X130 F12000
G1 Y0   F12000

G1 Y250 F12000
G1 X100 F12000
G1 Y0   F12000

G1 Y250 F12000
G1 X70  F12000
G1 Y0   F12000

G1 Y250 F12000
G1 X30  F12000          ; **last pass now at X30 instead of X40**
G1 Y0   F12000          ; finish at front edge on X30

;===============================  END SECTION  =============================

M73 P74 R2
G1 X65 Y245 F12000     ; move to safe corner before parking
G1 Y265 F3000          ; final park at rear edge (idle position)

; --- V2.93 MQTT sentinel: Safety (push-done) ---
M104 S4                ; FL_S2 safety sentinel (run safety check via nozzle_target_temper=4)

; --- TRIGGER SAFETY CHECK: Double tap ---
G1 Z243 F3000    ; Go to position
M400
G1 Z255 F1000    ; Tap 1
G4 P150
G1 Z243 F3000
G4 P300
G1 Z255 F1000    ; Tap 2
G4 S5
G1 Z243 F3000

; --- Wait for safety check (5-step sequence) ---
; Bender extend(7s) + retract(7s) + extend(7s) + door open(8s) + door close(8s) = ~37s
G4 P20000        ; Wait for safety check

; --- V2.93 MQTT sentinel: T3 (push-done, door close) ---
M104 S5                ; FL_S2 T3 sentinel (final door close via nozzle_target_temper=5)

; @fl:section:end "p2s.clear.sweep"
; @fl:section:start "p2s.stage2.trigger3"
; --- TRIGGER 3: Long press (4-6 seconds) - Final door close ---
G1 Z255 F3000
M400       ; Press switch (slow = ~5s contact)
G4 S5
M400
G1 Z220 F3000    ; Release switch
; @fl:section:end "p2s.stage2.trigger3"

M106 S0 ; turn off fan
M106 P2 S0 ; turn off remote part cooling fan
M106 P3 S0 ; turn off chamber cooling fan

M400 ; wait all motion done
M17 S
M17 Z0.4 ; lower z motor current to reduce impact if there is something in the bottom

M400 P100
M17 R ; restore z current

M220 S100  ; Reset feedrate magnitude
M201.2 K1.0 ; Reset acc magnitude
M73.2   R1.0 ;Reset left time magnitude
M1002 set_gcode_claim_speed_level : 0

M17 X0.8 Y0.8 Z0.5 ; lower motor current to 45% power
M73 P100 R0
; EXECUTABLE_BLOCK_END


; === END OF LOOP 1 ===
; Preparing for next loop...
G4 S2 ; brief pause between loops

